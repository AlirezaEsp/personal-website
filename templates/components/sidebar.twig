<div class="user-bar userbar-fixed text-center bs-light-mode">
    <div class="box-author mb_12">
        <div class="img-style mb_16">
            <img
                decoding="async"
                loading="lazy"
                src="assets/images/user/profile-pic.png"
                {# src="assets/images/user/avatar.webp" #}
                width="314"
                height="314"
                alt="feature post"
            >
        </div>
        <div class="info">
            <div class="name font-4 fw-5 text_white mb_8">{{ profile.full_name }}</div>
            <div class="text-label fw-6 text_primary-color font-3 mb_16 letter-spacing-1">
                {{ profile.title }}
            </div>
            <a href="mailto:{{ profile.email }}" class="hover-underline-link text_white text-body-2 mb_4">{{ profile.email }}</a>
            <br>
            <a href="#" class="hover-underline-link text_white text-body-2 mb_4">{{ profile.phone }}</a>
            <p class="text-caption-2 text_secondary-color font-3">
                Based in {{ profile.location }}
            </p>
        </div>
    </div>
    <ul class="list-icon d-flex justify-content-center mb_16">
        <li>
            <a href="{{ profile.socials.linkedin }}" class="icon-LinkedIn"></a>
        </li>
        <li>
            <a href="{{ profile.socials.github }}" class="icon-GitHub"></a>
        </li>
        {# <li>
            <a href="#" class="icon-X"></a>
        </li>
        <li>
            <a href="#" class="icon-dribbble"></a>
        </li> #}
    </ul>
    <a href="#" class="tf-btn btn-w-full style-border mb_12">
        <span class="bg_btn"></span>
        <span class="title">
            <i class="icon-ReadCvLogo"></i>View My CV
        </span>
        <span class="effect-shine"></span>
    </a>
    <a href="#contact" class="tf-btn style-1 animate-hover-btn btn-w-full">
        <i class="icon-EnvelopeSimple"></i>
        <span>Contact Me</span>
    </a>
    <div class="item-shape">
        <img src="assets/images/item/small-comet.png" alt="item">
    </div>
</div>