<div id="technologies" class="section-technologies section spacing-1">
    <div class="heading-section mb_44">
        <div class="tag-heading text-uppercase text-label font-3 letter-spacing-1 mb_32">
            Technologies
        </div>
        <h3 class="text_white fw-5  split-text effect-blur-fade">
            My Tech Stack
        </h3>
    </div>
    <div class="technology-grid">
        {% for technology in technologies %}
            <div class="technology-item scrolling-effect effectBottom" style="--ability: {{ technology.percentage }}%;">
                <img src="assets/images/logo/{{ technology.title }}.png" alt="Technology logo">
                <span class="technology-progress-marker">
                    <span>
                        {{ technology.percentage }}%
                    </span>
                </span>
            </div>
        {% endfor %}
    </div>
</div>